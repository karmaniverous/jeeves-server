@startuml access-decision-flow
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam ActivityDiamondBackgroundColor #ECECFF
skinparam ActivityDiamondBorderColor #9370DB
skinparam ActivityBackgroundColor #ECECFF
skinparam ActivityBorderColor #9370DB

start

:Request arrives;

if (Path contains a ".." segment?) then (Yes)
  :REJECTED (400);<<#ef4444>>
  stop
endif

if (Valid session cookie\n(Google OAuth insider)?) then (Yes)
  if (Path within the\ninsider's scopes?) then (Yes)
    :INSIDER access\n(within scopes);<<#22c55e>>
    stop
  endif
endif

if (Has ?key=*** parameter?) then (Yes)
  if (Matches machine\ninsider key?) then (Yes)
    if (Path within\nkey scopes?) then (Yes)
      :INSIDER access\n(within scopes);<<#22c55e>>
      stop
    endif
  elseif (Matches outsider key?\n(machine or insider seed)) then (Yes)
    if (Path matches key path or ancestor,\nwithin issuer scopes?) then (Yes)
      :OUTSIDER access;<<#22c55e>>
      stop
    endif
  endif
endif

if (Valid session cookie?) then (Yes)
  :DENIED (403)\npath outside scope;<<#ef4444>>
  stop
else (No)
  :DENIED (401)\n(or redirect to Google login);<<#f59e0b>>
  stop
endif

@enduml
