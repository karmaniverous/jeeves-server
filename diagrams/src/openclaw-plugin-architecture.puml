@startuml openclaw-plugin-architecture
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam componentStyle rectangle
skinparam packageStyle rectangle

actor "jeeves install" as installer

package "OpenClaw Gateway" {
  [openclaw plugins install] as ocinstall
  [Plugin: register(api)] as register
  [Tool call] as call
}

package "jeeves-server-openclaw" {
  [createGuardedApi()] as guard
  [createPluginToolset()\nserver_status / _config /\n_config_apply / _service] as toolset
  [registerServerTools()\nserver_* / oauth_*] as tools
  [ConfigRootResolver\nplugin config → JEEVES_CONFIG_ROOT] as resolver
  file "skills/jeeves-server\nSKILL.md" as skill
}

package "@karmaniverous/jeeves (core)" {
  [init(workspacePath, configRoot)] as init
}

cloud "jeeves-server API" as api
file "plugins.entries.<id>.config\n(configRoot, apiUrl, pluginKey)" as cfg

installer --> ocinstall : npm:<pkg>@<ver> --pin
installer --> cfg : write plugin config
ocinstall --> register : activate (config may be absent)
ocinstall ..> skill : manifest skills

register --> guard : wrap registerTool
guard --> toolset : register
guard --> tools : register
register ..> resolver : warn once if unset

call --> resolver : resolve configRoot
resolver ..> cfg : read
resolver --> init : first use
call --> api : when resolved
resolver ..> call : else "configRoot not configured" error

@enduml
