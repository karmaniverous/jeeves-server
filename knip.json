{
  "project": ["src/**/*.ts"],
  "ignore": ["server.js"],
  "ignoreDependencies": [
    "@fastify/static",
    "@karmaniverous/jsonmap",
    "@panzoom/panzoom",
    "@types/lodash-es",
    "ajv",
    "lodash-es",
    "cross-env",
    "tslib"
  ],
  "rules": {
    "exports": "off",
    "types": "off",
    "unlisted": "off"
  },
  "vitest": {
    "entry": ["src/**/*.test.ts"]
  }
}
