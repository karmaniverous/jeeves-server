{
  "workspaces": {
    "packages/service": {
      "entry": [
        "src/cli/start-server.ts",
        "src/dev-server.ts",
        "test-docs/**/*.js",
        "scripts/capture-wire.ts",
        "src/test/wire/wireRecord.record.ts"
      ],
      "includeEntryExports": true,
      "vitest": {
        "config": ["vitest.config.{js,ts}", "vitest.wire-record.config.ts"]
      }
    },
    "packages/service/client": {
      "project": ["src/**/*.{ts,tsx,css}"],
      "ignore": ["src/components/ui/**"],
      "includeEntryExports": true
    },
    "packages/openclaw": {},
    "packages/core": {}
  },
  "ignoreExportsUsedInFile": true
}
