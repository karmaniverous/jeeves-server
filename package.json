{
  "name": "jeeves-server-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/service/client"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/core && npm run build --workspace=packages/service && npm run build --workspace=packages/openclaw",
    "lint": "eslint . && npm run lint --workspace=packages/service/client",
    "lint:fix": "eslint --fix . && npm run lint:fix --workspace=packages/service/client",
    "test": "npm run test --workspaces --if-present",
    "knip": "knip",
    "typecheck": "npm run typecheck --workspace=packages/core && npm run typecheck --workspace=packages/service && npm run typecheck --workspace=packages/openclaw && npm run typecheck --workspace=packages/service/client",
    "docs": "typedoc"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/eslint-plugin": "^1.6.17",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "git-cliff": "^2.13.1",
    "knip": "^6.13.1",
    "lefthook": "^2.1.6",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typedoc-plugin-replace-text": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3"
  },
  "engines": {
    "node": ">=22"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.60.3",
    "@rollup/rollup-linux-x64-musl": "4.60.3",
    "@rollup/rollup-darwin-x64": "4.60.3",
    "@rollup/rollup-darwin-arm64": "4.60.3"
  }
}
