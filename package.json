{
  "name": "jeeves-server-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/service/client"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/core && npm run build --workspace=packages/sdk && npm run build --workspace=packages/service && npm run build --workspace=packages/openclaw",
    "lint": "eslint . && npm run lint --workspace=packages/service/client && npm run format:check",
    "format:check": "prettier --check .",
    "lint:fix": "eslint --fix . && npm run lint:fix --workspace=packages/service/client",
    "test": "npm run test:scripts && npm run test --workspaces --if-present",
    "test:scripts": "node --test scripts/*.test.mjs",
    "knip": "knip",
    "typecheck": "npm run typecheck --workspace=packages/core && npm run typecheck --workspace=packages/sdk && npm run typecheck --workspace=packages/service && npm run typecheck --workspace=packages/openclaw && npm run typecheck --workspace=packages/service/client",
    "docs": "typedoc"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-tsdoc": "^0.5.4",
    "git-cliff": "^2.14.2",
    "knip": "^6.45.1",
    "lefthook": "^2.2.2",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "semver": "^7.8.6",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typedoc-plugin-replace-text": "^4.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "engines": {
    "node": ">=24.22.2"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.68.3",
    "@rollup/rollup-linux-x64-musl": "4.68.3",
    "@rollup/rollup-darwin-x64": "4.68.3",
    "@rollup/rollup-darwin-arm64": "4.68.3",
    "@tailwindcss/oxide-android-arm64": "4.3.5",
    "@tailwindcss/oxide-darwin-arm64": "4.3.5",
    "@tailwindcss/oxide-darwin-x64": "4.3.5",
    "@tailwindcss/oxide-freebsd-x64": "4.3.5",
    "@tailwindcss/oxide-linux-arm-gnueabihf": "4.3.5",
    "@tailwindcss/oxide-linux-arm64-gnu": "4.3.5",
    "@tailwindcss/oxide-linux-arm64-musl": "4.3.5",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.5",
    "@tailwindcss/oxide-linux-x64-musl": "4.3.5",
    "@tailwindcss/oxide-wasm32-wasi": "4.3.5",
    "@tailwindcss/oxide-win32-arm64-msvc": "4.3.5"
  },
  "overrides": {
    "lodash-es": "^4.18.1"
  },
  "allowScripts": {
    "@turbodocx/html-to-docx": true,
    "esbuild": true,
    "fsevents": true,
    "lefthook": true,
    "puppeteer": true
  }
}
