{
  "name": "jeeves-server-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/service/client"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/service && npm run build --workspace=packages/openclaw",
    "lint": "eslint . && npm run lint --workspace=packages/service/client",
    "lint:fix": "eslint --fix . && npm run lint:fix --workspace=packages/service/client",
    "test": "npm run test --workspaces --if-present",
    "knip": "knip",
    "typecheck": "npm run typecheck --workspace=packages/service && npm run typecheck --workspace=packages/openclaw && npm run typecheck --workspace=packages/service/client",
    "docs": "typedoc"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@vitest/eslint-plugin": "^1.6.4",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-tsdoc": "^0.5.0",
    "knip": "^5.79.0",
    "lefthook": "^2.0.13",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.3",
    "tsx": "^4.19.2",
    "typedoc": "^0.28.17",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typedoc-plugin-replace-text": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0"
  },
  "engines": {
    "node": ">=20"
  }
}
