{
  "name": "@karmaniverous/jeeves-server",
  "version": "1.1.0",
  "description": "Fastify server for Jeeves - webhooks, file serving, markdown rendering",
  "type": "module",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "prebuild": "node -e \"const fs=require('fs');['dist','.tsbuildinfo'].forEach(p=>{try{fs.rmSync(p,{recursive:true,force:true})}catch{}})\"",
    "build": "tsc",
    "typecheck": "cross-env NODE_OPTIONS=--max-old-space-size=4096 tsc --noEmit",
    "lint": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && eslint .",
    "lint:fix": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && eslint --fix .",
    "test": "vitest run",
    "knip": "knip",
    "changelog": "auto-changelog",
    "release": "release-it"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karmaniverous/jeeves-server.git"
  },
  "author": "Jeeves",
  "license": "MIT",
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.0.3",
    "@karmaniverous/jsonmap": "^0.3.1",
    "@panzoom/panzoom": "^4.5.1",
    "@turbodocx/html-to-docx": "^1.1.0",
    "ajv": "^8.17.1",
    "fastify": "^5.2.3",
    "highlight.js": "^11.11.1",
    "lodash-es": "^4.17.21",
    "marked": "^17.0.1",
    "puppeteer-core": "^24.37.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/eslint-plugin": "^1.6.4",
    "auto-changelog": "^2.5.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-tsdoc": "^0.5.0",
    "happy-dom": "^20.0.11",
    "knip": "^5.79.0",
    "lefthook": "^2.0.13",
    "prettier": "^3.7.4",
    "release-it": "^19.2.2",
    "tslib": "^2.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0",
    "vitest": "^4.0.16"
  },
  "auto-changelog": {
    "output": "CHANGELOG.md",
    "unreleased": true,
    "commitLimit": false,
    "hideCredit": true
  },
  "release-it": {
    "git": {
      "changelog": "npx auto-changelog --unreleased-only --stdout --template https://raw.githubusercontent.com/release-it/release-it/main/templates/changelog-compact.hbs",
      "commitMessage": "chore: release v${version}",
      "requireBranch": "main"
    },
    "github": {
      "release": true
    },
    "hooks": {
      "after:init": [
        "npm run lint",
        "npm run test",
        "npm run knip",
        "npm run build"
      ],
      "before:npm:release": [
        "npx auto-changelog -p"
      ],
      "after:release": [
        "git switch -c release/${version}",
        "git push -u origin release/${version}",
        "git switch ${branchName}"
      ]
    },
    "npm": {
      "publish": false
    }
  }
}
