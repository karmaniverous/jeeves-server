{
  "name": "@karmaniverous/jeeves-server-core",
  "version": "0.1.1",
  "type": "module",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "npx rimraf dist",
    "build": "cross-env NO_COLOR=1 rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "changelog": "git-cliff -o CHANGELOG.md",
    "release": "dotenvx run -f .env.local -- release-it",
    "release:pre": "dotenvx run -f .env.local -- release-it --no-git.requireBranch --github.prerelease --preRelease",
    "postbuild": "npx rimraf dist/rollup.config.d.ts dist/rollup.config.d.ts.map"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      }
    }
  },
  "types": "dist/src/index.d.ts",
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.59.1",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "cross-env": "^10.1.0",
    "release-it": "^19.2.4",
    "rollup": "^4.60.3",
    "tslib": "^2.8.1",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=22"
  },
  "release-it": {
    "git": {
      "changelog": "npx git-cliff --unreleased --strip header",
      "commitMessage": "chore: release @karmaniverous/jeeves-server-core v${version}",
      "tagName": "core/${version}",
      "requireBranch": "main"
    },
    "github": {
      "release": true
    },
    "hooks": {
      "after:init": [
        "npm run lint",
        "npm run typecheck",
        "npm run test",
        "npm run build"
      ],
      "before:npm:release": [
        "npx git-cliff -o CHANGELOG.md",
        "git add -A"
      ],
      "after:release": [
        "git switch -c release/core/${version}",
        "git push -u origin release/core/${version}",
        "git switch ${branchName}"
      ]
    },
    "npm": {
      "publish": true
    }
  }
}
