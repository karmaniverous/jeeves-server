{
  "author": "Jeeves",
  "dependencies": {
    "@karmaniverous/jeeves": "0.6.0-4",
    "zod": "^4.6.5"
  },
  "description": "Shared cryptographic utilities and API types for jeeves-server packages.",
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.30.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "cross-env": "^10.1.0",
    "release-it": "^21.1.0",
    "rollup": "^4.63.5",
    "tslib": "^2.8.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "name": "@karmaniverous/jeeves-server-core",
  "publishConfig": {
    "access": "public"
  },
  "release-it": {
    "git": {
      "changelog": "npx git-cliff --unreleased --strip header",
      "commitMessage": "chore: release @karmaniverous/jeeves-server-core v${version}",
      "requireBranch": "main",
      "tagName": "core/${version}"
    },
    "github": {
      "release": true
    },
    "hooks": {
      "after:init": [
        "npm run lint",
        "npm run typecheck",
        "npm run test",
        "npm run build"
      ],
      "after:release": [
        "git switch -c release/core/${version}",
        "git push -u origin release/core/${version}",
        "git switch ${branchName}"
      ],
      "before:npm:release": [
        "npx git-cliff -o CHANGELOG.md",
        "git add -A"
      ]
    },
    "npm": {
      "publish": true
    }
  },
  "repository": {
    "directory": "packages/core",
    "type": "git",
    "url": "git+https://github.com/karmaniverous/jeeves-server.git"
  },
  "scripts": {
    "build": "cross-env NO_COLOR=1 rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "changelog": "git-cliff -o CHANGELOG.md",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "postbuild": "npx rimraf dist/rollup.config.d.ts dist/rollup.config.d.ts.map",
    "prebuild": "npx rimraf dist",
    "release": "dotenvx run -f .env.local -- release-it",
    "release:pre": "dotenvx run -f .env.local -- release-it --no-git.requireBranch --github.prerelease --preRelease",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "types": "dist/src/index.d.ts",
  "version": "0.2.0"
}
