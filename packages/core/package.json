{
  "name": "@karmaniverous/jeeves-server-core",
  "version": "0.1.0",
  "type": "module",
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "npx rimraf dist",
    "build": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "release": "dotenvx run -f .env.local -- release-it",
    "release:pre": "dotenvx run -f .env.local -- release-it --no-git.requireBranch --github.prerelease --preRelease"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      }
    }
  },
  "types": "dist/src/index.d.ts",
  "devDependencies": {
    "vitest": "^4.1.2",
    "release-it": "^19.2.4",
    "auto-changelog": "^2.5.0",
    "@dotenvx/dotenvx": "^1.59.1"
  },
  "engines": {
    "node": ">=22"
  },
  "release-it": {
    "git": {
      "changelog": "npx auto-changelog --unreleased-only --stdout --template https://raw.githubusercontent.com/release-it/release-it/main/templates/changelog-compact.hbs",
      "commitMessage": "chore: release @karmaniverous/jeeves-server-core v${version}",
      "tagName": "core/${version}",
      "requireBranch": "main"
    },
    "github": {
      "release": true
    },
    "hooks": {
      "after:init": [
        "npm run lint",
        "npm run typecheck",
        "npm run test",
        "npm run build"
      ],
      "before:npm:release": [
        "npx auto-changelog -p",
        "git add -A"
      ],
      "after:release": [
        "git switch -c release/core/${version}",
        "git push -u origin release/core/${version}",
        "git switch ${branchName}"
      ]
    },
    "npm": {
      "publish": true
    }
  }
}
