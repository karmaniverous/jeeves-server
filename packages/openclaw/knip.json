{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/index.ts",
    "src/cli.ts"
  ],
  "project": [
    "src/**/*.ts"
  ],
  "ignoreBinaries": [
    "rimraf",
    "cross-env",
    "rollup",
    "tsx",
    "eslint",
    "tsc",
    "git-cliff",
    "knip",
    "dotenvx",
    "release-it"
  ],
  "ignoreDependencies": [
    "@dotenvx/dotenvx",
    "cross-env",
    "release-it",
    "tslib"
  ]
}
