{
  "author": "Jeeves",
  "bugs": {
    "url": "https://github.com/karmaniverous/jeeves-server/issues"
  },
  "dependencies": {
    "@karmaniverous/jeeves": "^0.11.0",
    "@karmaniverous/jeeves-server-core": "^0.4.0"
  },
  "description": "Typed TypeScript client for the jeeves-server HTTP API: browse, read, write, share, export and every other route, from the server's endpoint catalog. Browser-safe.",
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.38.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@vitest/coverage-v8": "^5.1.0",
    "cross-env": "^10.1.0",
    "release-it": "^21.1.2",
    "rollup": "^4.68.3",
    "tslib": "^2.9.1",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24.22.2"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/karmaniverous/jeeves-server/tree/main/packages/sdk#readme",
  "keywords": [
    "jeeves-server",
    "sdk",
    "client",
    "file-server",
    "share-links"
  ],
  "license": "MIT",
  "name": "@karmaniverous/jeeves-server-sdk",
  "publishConfig": {
    "access": "public"
  },
  "release-it": {
    "git": {
      "changelog": "npx git-cliff --unreleased --strip header",
      "commitMessage": "chore: release @karmaniverous/jeeves-server-sdk v${version}",
      "requireBranch": "main",
      "tagName": "sdk/${version}"
    },
    "github": {
      "release": true,
      "releaseName": "${name.split('/').pop()}@${version}",
      "releaseNotes": "npx git-cliff --tag sdk/${version} --unreleased --strip header"
    },
    "hooks": {
      "before:init": [
        "node ../../scripts/check-core-range.mjs"
      ],
      "after:bump": [
        "npx git-cliff --tag sdk/${version} -o CHANGELOG.md",
        "npm install --package-lock-only --ignore-scripts",
        "git add ../../package-lock.json"
      ],
      "after:init": [
        "npm run lint",
        "npm run typecheck",
        "npm run test",
        "npm run build"
      ],
      "after:release": [
        "git switch -c release/sdk/${version}",
        "git push -u origin release/sdk/${version}",
        "git switch ${branchName}"
      ],
      "before:npm:release": [
        "git add -A"
      ]
    },
    "npm": {
      "publish": true
    }
  },
  "repository": {
    "directory": "packages/sdk",
    "type": "git",
    "url": "git+https://github.com/karmaniverous/jeeves-server.git"
  },
  "scripts": {
    "build": "cross-env NO_COLOR=1 rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "changelog": "git-cliff -o CHANGELOG.md",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prebuild": "npx rimraf dist",
    "release": "dotenvx run -f .env.local -- release-it",
    "release:pre": "dotenvx run -f .env.local -- release-it --no-git.requireBranch --github.preRelease --preRelease",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "version": "0.1.0-0"
}
