{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/cli/index.ts"
  ],
  "project": [
    "src/**/*.ts"
  ],
  "ignoreBinaries": [
    "tsx",
    "rimraf",
    "tsc",
    "cross-env",
    "vitest",
    "auto-changelog",
    "dotenvx",
    "release-it",
    "eslint",
    "knip"
  ],
  "ignoreDependencies": [
    "puppeteer",
    "@dotenvx/dotenvx",
    "auto-changelog",
    "cross-env",
    "release-it",
    "rimraf"
  ],
  "ignoreExportsUsedInFile": true
}
