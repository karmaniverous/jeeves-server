{
  "author": "Jeeves",
  "bin": {
    "jeeves-server": "./dist/src/cli/index.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.5",
    "@karmaniverous/jeeves": "^0.5.12",
    "@karmaniverous/jeeves-server-core": "^0.2.0",
    "@karmaniverous/jsonmap": "^2.1.1",
    "@mermaid-js/mermaid-cli": "^12.0.0",
    "@turbodocx/html-to-docx": "^1.23.1",
    "ajv": "^8.20.0",
    "archiver": "^8.0.0",
    "cheerio": "^1.2.0",
    "fastify": "^5.12.5",
    "handlebars": "^4.7.9",
    "lz-string": "^1.5.0",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mime-types": "^3.0.2",
    "nodemailer": "^10.0.10",
    "package-directory": "^8.2.0",
    "picomatch": "^4.0.7",
    "plantuml-encoder": "^1.4.0",
    "puppeteer": "^25.12.0",
    "puppeteer-core": "^25.12.0",
    "radash": "^12.1.1"
  },
  "description": "Secure file browser, markdown viewer, and webhook gateway with PDF/DOCX export and expiring share links",
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.30.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/archiver": "^8.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/picomatch": "^4.0.3",
    "@vitest/coverage-v8": "^5.0.2",
    "cross-env": "^10.1.0",
    "happy-dom": "^20.14.5",
    "release-it": "^21.1.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.5",
    "tslib": "^2.8.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "content",
    "guides",
    "scripts"
  ],
  "keywords": [
    "fastify",
    "react",
    "markdown",
    "file-server",
    "file-browser",
    "pdf-export",
    "docx-export",
    "mermaid",
    "typescript",
    "webhook",
    "document-viewer",
    "self-hosted",
    "share-links",
    "hmac",
    "google-oauth"
  ],
  "license": "MIT",
  "name": "@karmaniverous/jeeves-server",
  "publishConfig": {
    "access": "public"
  },
  "release-it": {
    "git": {
      "changelog": "npx git-cliff --unreleased --strip header",
      "commitMessage": "chore: release @karmaniverous/jeeves-server v${version}",
      "requireBranch": "main",
      "tagName": "service/${version}"
    },
    "github": {
      "release": true
    },
    "hooks": {
      "after:init": [
        "npm run lint",
        "npm run typecheck",
        "npm run test",
        "npm run build"
      ],
      "after:release": [
        "git switch -c release/service/${version}",
        "git push -u origin release/service/${version}",
        "git switch ${branchName}"
      ],
      "before:npm:release": [
        "npx git-cliff -o CHANGELOG.md",
        "git add -A"
      ]
    },
    "npm": {
      "publish": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karmaniverous/jeeves-server.git"
  },
  "scripts": {
    "build": "cross-env NO_COLOR=1 rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "changelog": "git-cliff -o CHANGELOG.md",
    "dev": "tsx watch src/server.ts",
    "knip": "knip",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "postbuild": "cd client && npm run build",
    "postinstall": "node scripts/download-plantuml.js",
    "prebuild": "npx rimraf dist .tsbuildinfo",
    "release": "dotenvx run -f .env.local -- release-it",
    "release:pre": "dotenvx run -f .env.local -- release-it --no-git.requireBranch --github.prerelease --preRelease",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "typecheck": "cross-env NODE_OPTIONS=--max-old-space-size=4096 tsc --noEmit"
  },
  "type": "module",
  "version": "3.13.1"
}
