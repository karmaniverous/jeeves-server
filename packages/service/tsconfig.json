{
  "compilerOptions": {
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "isolatedModules": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "tsBuildInfoFile": "./.tsbuildinfo",
    "types": [
      "node",
      "vitest/globals"
    ],
    "rootDir": "."
  },
  "exclude": [
    "coverage",
    "dist",
    "node_modules",
    "logs",
    "server.js",
    "jeeves.config.template.ts"
  ],
  "include": [
    "src/**/*",
    "*.config.ts",
    "rollup.config.ts"
  ]
}