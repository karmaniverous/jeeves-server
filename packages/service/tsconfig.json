{
  "compilerOptions": {
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node", "vitest/globals"],
    "paths": {
      "@karmaniverous/jeeves-server-core": ["../core/src/index.ts"]
    }
  },
  "exclude": [
    "coverage",
    "dist",
    "node_modules",
    "logs",
    "server.js",
    "jeeves.config.template.ts"
  ],
  "include": ["src/**/*", "*.config.ts", "rollup.config.ts"]
}
